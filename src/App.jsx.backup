// Demo learning path: each topic lists its prerequisites.
const topics = [
  { id: 'arith', label: 'Arithmetic', level: 0, needs: [] },
  { id: 'algebra', label: 'Algebra', level: 1, needs: ['arith'] },
  { id: 'geometry', label: 'Geometry', level: 1, needs: ['arith'] },
